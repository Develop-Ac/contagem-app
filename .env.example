# -----------------------------------------------------------------------------
# Sistema de Contagem — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) ou `.env.production` (publicação).
# O prefixo NEXT_PUBLIC_ é obrigatório: a chamada à API acontece no navegador.
#
# IMPORTANTE: variáveis NEXT_PUBLIC_ são gravadas dentro do bundle durante o
# `next build`. Alterar o valor exige um novo build.
# -----------------------------------------------------------------------------

# URL base da API Estoque Service, sem barra final.
#   desenvolvimento: http://localhost:8000
#   produção:        http://estoque-service.acacessorios.local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000